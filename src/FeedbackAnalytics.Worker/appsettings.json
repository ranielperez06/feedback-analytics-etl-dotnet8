{
  "ConnectionStrings": {
    "PostgreSql": null
  },
  "Sources": {
    "Csv": {
      "FilePath": "data/input/encuestas.csv",
      "Delimiter": ","
    },
    "PostgreSql": {
      "Query": "SELECT review_id, author_name, review_text, score, created_at, product_name FROM source.reviews ORDER BY created_at"
    },
    "Api": {
      "BaseUrl": "https://jsonplaceholder.typicode.com/",
      "Endpoint": "comments?postId=1",
      "MaxRecords": 25,
      "TimeoutSeconds": 30
    }
  },
  "Staging": {
    "Schema": "staging",
    "Table": "extracted_feedback"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  }
}
